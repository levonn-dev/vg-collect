# Build artifacts (the frontend Vite build output; .task/ is the
# Taskfile checksum cache). Scoped to the frontend so it does not catch
# the bff's committed placeholder bundle, which ships embedded in the
# binary and is overwritten by the real build inside the image.
/frontend/dist/
/.task/

# Test artifacts (Go coverage profiles written per-module by
# scripts/coverage.sh; cleaned up nowhere on purpose, cheap to regen).
*.out
*.filtered

# Environment; committed example, real values gitignored. See .env.example.
.env*
!.env.example

# Editor / IDE.
/.idea/
/.vscode/
*.swp
.DS_Store

# Node.
node_modules/

# Helm dependency artifacts; re-fetched by `task lint` and
# `task bootstrap:cluster` (helm dependency build/update).
deploy/charts/*/charts/
deploy/charts/*/Chart.lock

# Locally built service binaries (a go build in a service directory
# drops the binary next to its source; never committed).
/services/user/user
/services/auth/auth
