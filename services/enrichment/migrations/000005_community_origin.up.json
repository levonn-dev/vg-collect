[
  {
    "update": "products",
    "updates": [
      {
        "q": { "origin": { "$exists": false } },
        "u": { "$set": { "origin": "provider" } },
        "multi": true
      }
    ]
  },
  { "dropIndexes": "products", "index": "products_game_identity" },
  { "dropIndexes": "products", "index": "products_hardware_identity" },
  {
    "createIndexes": "products",
    "indexes": [
      {
        "key": { "type": 1, "igdb.game_id": 1, "platform.igdb_id": 1, "pricecharting.pc_product_id": 1 },
        "name": "products_game_identity",
        "unique": true,
        "partialFilterExpression": { "type": "game", "origin": "provider" }
      },
      {
        "key": { "type": 1, "pricecharting.pc_product_id": 1, "region": 1, "edition": 1, "variant": 1 },
        "name": "products_hardware_identity",
        "unique": true,
        "partialFilterExpression": { "type": { "$in": ["console", "accessory"] }, "origin": "provider" }
      }
    ]
  }
]
