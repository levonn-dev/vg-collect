        "name": "products_game_identity",
        "unique": true,
        "partialFilterExpression": { "type": "game" }
      },
      {
        "key": { "type": 1, "pricecharting.pc_product_id": 1, "region": 1, "edition": 1, "variant": 1 },
        "name": "products_hardware_identity",
        "unique": true,
        "partialFilterExpression": { "type": { "$in": ["console", "accessory"] } }
      },
      {
        "key": { "name": 1 },
        "name": "products_name"
      }
    ]
  },
  { "create": "igdb_raw" },
  { "create": "platforms" }
]
