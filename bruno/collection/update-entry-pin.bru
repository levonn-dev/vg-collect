meta {
  name: update entry (pin + rate + tag)
  type: http
  seq: 7
}

put {
  url: {{collection_url}}/entries/{{entry_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "region": "ntsc_u",
    "packaging": "cib",
    "pricing_mode": "auto",
    "status": "backlog",
    "pinned": true,
    "rating": 9,
    "price_paid_cents": 4500,
    "tag_ids": ["{{tag_id}}"]
  }
}

docs {
  Full replacement of the mutable state (absent optional fields
  clear). Run create-tag first for tag_id. Expect 200 with pinned
  true and the tag attached.
}
