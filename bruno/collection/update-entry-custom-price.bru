meta {
  name: update entry (custom price)
  type: http
  seq: 15
}

put {
  url: {{collection_url}}/entries/{{entry_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "region": "ntsc_u",
    "packaging": "cib",
    "pricing_mode": "custom",
    "custom_value_cents": 12345,
    "status": "backlog",
    "pinned": false,
    "price_paid_cents": 4500
  }
}

assert {
  res.status: eq 200
  res.body.pricing_mode: eq custom
  res.body.value_cents: eq 12345
  res.body.custom_value_set_at: isDefined
}

docs {
  Full replacement of the entry's mutable state that flips it to a
  user-set price: pricing_mode custom means value_cents is taken
  directly from custom_value_cents (packaging-independent), not composed
  from a catalog product. Run create-entry first for entry_id. Expect
  200 with value_cents 12345 and custom_value_set_at stamped by the
  server (it re-stamps only when the amount changes). This works on a
  product-backed entry too: the catalog price is ignored while the mode
  is custom, and the entry keeps its product_id join. auto is the only
  mode a custom (off-catalog) entry cannot use.
}
