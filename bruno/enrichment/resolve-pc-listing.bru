meta {
  name: resolve pc listing (price anchor)
  type: http
  seq: 13
}

post {
  url: {{enrichment_url}}/products/resolve
  body: json
  auth: inherit
}

body:json {
  {
    "type": "pc_listing",
    "pc_product_id": {{pc_product_id}}
  }
}

assert {
  res.status: eq 200
  res.body.type: eq pc_listing
  res.body.pricecharting: isDefined
  res.body.igdb: isUndefined
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("pc_listing_product_id", res.body.id);
  }
}

docs {
  Run search-pc-listings first: it stores a real pc_product_id into the
  pc_product_id env var that this request anchors on. Resolve mints (or
  finds) a price-anchor product for that exact listing: expect 200 with
  type pc_listing and the pricecharting subdoc carrying the listing's
  prices. There is no igdb projection (a listing is a price source, not
  a catalog game), so the igdb key is absent. The product id is stored
  as pc_listing_product_id so a collection entry can proxy-price against
  it. region/edition/variant are ignored here (the listing IS the exact
  variant).
}
