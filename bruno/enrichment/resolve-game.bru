meta {
  name: resolve game (find-or-create, localized)
  type: http
  seq: 3
}

post {
  url: {{enrichment_url}}/products/resolve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "type": "game",
    "igdb_game_id": 11227,
    "platform_igdb_id": 19
  }
}

assert {
  res.status: eq 200
  res.body.igdb.localizations: isDefined
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("product_id", res.body.id);
  }
}

docs {
  Expect 200; Trials of Mana (Seiken Densetsu 3) on Super Nintendo
  Entertainment System - a real IGDB id/platform pair (not a stub
  fixture), so this resolves against the live catalog path in every
  provider mode. res.body.igdb.localizations carries its ja-JP bundle
  (name 聖剣伝説 3, translit Seiken Densetsu 3), asserted present above -
  the same matched_region search case frontend/e2e/region-locale.spec.ts
  exercises through the app. PriceCharting matching is independent of
  this resolve and is not asserted here: on this stack the product
  currently resolves with no pricecharting match (this dev deployment's
  PriceCharting coverage for the title, not a contract of the endpoint).
  The resolved product id is stored into the product_id env var.
}
