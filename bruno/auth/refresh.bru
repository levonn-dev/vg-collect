meta {
  name: refresh (rotates the token)
  type: http
  seq: 2
}

post {
  url: {{auth_url}}/token/refresh
  body: json
  auth: none
}

body:json {
  {
    "refresh_token": "{{refresh_token}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("prev_refresh_token", bru.getEnvVar("refresh_token"));
    bru.setEnvVar("access_token", res.body.access_token);
    bru.setEnvVar("refresh_token", res.body.refresh_token);
  }
}
