meta {
  name: revoke (logout)
  type: http
  seq: 4
}

post {
  url: {{auth_url}}/token/revoke
  body: json
  auth: none
}

body:json {
  {
    "refresh_token": "{{refresh_token}}"
  }
}

docs {
  204 in the normal case (idempotent; the contract also declares 500
  for unexpected revocation failures). Afterwards refresh returns 401
  and a new login is required.
}
