meta {
  name: submissions - admin queue (capture bob's id)
  type: http
  seq: 31
}

get {
  url: {{bff_url}}/api/admin/submissions
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.total_count: isDefined
}

script:post-response {
  if (res.status === 200) {
    const row = res.body.submissions.find(s => s.entry_id === bru.getEnvVar("bob_entry_id"));
    bru.setEnvVar("bob_sub_id", row.id);
  }
}
