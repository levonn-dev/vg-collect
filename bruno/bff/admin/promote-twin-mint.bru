meta {
  name: promote - mint the twin
  type: http
  seq: 36
}

post {
  url: {{bff_url}}/api/admin/products
  body: json
  auth: none
}

body:json {
  {
    "type": "game",
    "name": "Terranigma Twin"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("promote_twin_id", res.body.id);
  }
}
