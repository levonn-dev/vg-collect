meta {
  name: admin - dev login (populates the cookie jar)
  type: http
  seq: 1
}

get {
  url: {{bff_url}}/api/auth/login?provider=dev&user=admin
  body: none
  auth: none
}

docs {
  Run task grant-fixture-admin first, then this login: roles land in
  the JWT at login time, so the grant must precede the session this
  folder uses. Without the grant every admin request below answers
  403 forbidden.
}
