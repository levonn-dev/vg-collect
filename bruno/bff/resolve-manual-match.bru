meta {
  name: resolve game with manual match (via gateway)
  type: http
  seq: 16
}

post {
  url: {{bff_url}}/api/products/resolve
  body: json
  auth: none
}

body:json {
  {
    "type": "game",
    "igdb_game_id": {{bff_manual_igdb_game_id}},
    "platform_igdb_id": {{bff_manual_platform_igdb_id}},
    "pc_product_id": {{bff_pc_product_id}}
  }
}

assert {
  res.status: eq 200
  res.body.type: eq game
  res.body.igdb: isDefined
  res.body.pricecharting.pc_product_id: eq {{bff_pc_product_id}}
  res.body.pricecharting.match_confidence: eq 1
  res.body.pricecharting.verified: eq false
}

docs {
  Run search-games and search-pc-listings first (they store the ids).
  Game identity is listing-keyed: the resolve lands on the product
  that carries the SENT listing for this game and platform, minting
  it on the first run and converging on it ever after - re-runs
  return the same product (the pc-id equality assert holds every
  time). The manual listing is unrelated to the game on purpose -
  manual match trusts the user's choice and applies no console
  filter. Residue: at most one game product per listing in
  enrichment-mongo, shared across runs.
}
