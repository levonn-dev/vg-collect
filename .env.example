# Copy to .env (gitignored). Tilt renders these into the ESO fake ClusterSecretStore.
# --- user service ---
PG_USER_PASSWORD=dev-user-pg-password
# --- auth service ---
PG_AUTH_PASSWORD=dev-auth-pg-password
# base64 of a 32-byte Ed25519 seed. This dev value decodes to readable
# ASCII on purpose (self-evidently not a production key). Generate real
# ones with: openssl rand -base64 32
AUTH_JWT_SIGNING_KEY=dmctY29sbGVjdC1kZXYtc2lnbmluZy1zZWVkLTAwMDE=
# Real "login with" apps; leave empty to keep that provider disabled
# (the dev provider covers credential-less local logins). When set,
# OAUTH_REDIRECT_URL below must be registered with the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Public callback for real providers; defaults to the local gateway.
# Only read when a real provider pair above is set.
OAUTH_REDIRECT_URL=http://localhost:8090/api/auth/callback
# --- bff ---
# base64 of a 32-byte AES key sealing the session cookie (same
# readable-ASCII convention as the signing seed above).
BFF_COOKIE_KEY=dmctY29sbGVjdC1kZXYtY29va2llLWtleS0wMDAwMDE=
# --- enrichment ---
MONGO_ENRICHMENT_PASSWORD=dev-enrichment-mongo-password
# Static token the refresh CronJob presents to POST /internal/refresh
# (X-Internal-Token). Rotate by moving the current value to the
# PREVIOUS var and putting the new one here; the service accepts both
# until PREVIOUS is emptied again.
ENRICHMENT_INTERNAL_REFRESH_TOKEN=dev-enrichment-refresh-token
ENRICHMENT_INTERNAL_REFRESH_TOKEN_PREVIOUS=
# Real provider credentials; leave empty to stay in stub mode (the
# embedded fixture catalog covers credential-less local runs). Tilt
# flips the service to real automatically when a full set is present.
# IGDB authenticates with a Twitch application - often the same app as
# the Twitch login provider above.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
PRICECHARTING_API_KEY=
# --- collection service ---
PG_COLLECTION_PASSWORD=dev-collection-pg-password
# --- social service ---
PG_SOCIAL_PASSWORD=dev-social-pg-password
# --- frontend site identity (build-time) ---
# Baked into the SPA at image build; not secrets and not runtime env.
# Unset means: name "vgkeep", upstream source link, no operator line,
# no credits, no named sign-in providers. Tilt derives the two list
# values from the provider credentials above, so normally there is
# nothing to set here. Set a value to override the derivation: what
# is set is what exists.
# Values are used verbatim - do not quote them; quotes would show up
# in rendered page text.
#VITE_SITE_NAME=
#VITE_SITE_OPERATOR=
#VITE_SITE_CONTACT=
#VITE_SITE_JURISDICTION=
#VITE_SITE_SOURCE_URL=
#VITE_SITE_DATA_SOURCES=igdb,pricecharting,frankfurter
#VITE_SITE_AUTH_PROVIDERS=google,twitch
