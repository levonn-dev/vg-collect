# Copy to .env (gitignored). Tilt renders these into the ESO fake ClusterSecretStore.
# --- user service ---
PG_USER_PASSWORD=dev-user-pg-password
# --- auth service ---
PG_AUTH_PASSWORD=dev-auth-pg-password
# base64 of a 32-byte Ed25519 seed; readable ASCII on purpose (not a
# production key). Generate real ones with: openssl rand -base64 32
AUTH_JWT_SIGNING_KEY=dmctY29sbGVjdC1kZXYtc2lnbmluZy1zZWVkLTAwMDE=
# Real "login with" apps; empty disables the provider (dev covers
# credential-less logins). When set, register OAUTH_REDIRECT_URL with it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Public callback for real providers; defaults to the local gateway.
# Only read when a real provider pair above is set.
OAUTH_REDIRECT_URL=http://localhost:8090/api/auth/callback
# Static secret the catalog-refresh/entry-rematch CronJobs POST as
# X-Internal-Token to /internal/service-token. To rotate: move current
# to PREVIOUS, put new here; both work until PREVIOUS is emptied.
AUTH_INTERNAL_SERVICE_TOKEN=dev-auth-service-token
AUTH_INTERNAL_SERVICE_TOKEN_PREVIOUS=
# --- bff ---
# base64 of a 32-byte AES key sealing the session cookie (same
# convention as the signing seed above).
BFF_COOKIE_KEY=dmctY29sbGVjdC1kZXYtY29va2llLWtleS0wMDAwMDE=
# --- enrichment ---
PG_ENRICHMENT_PASSWORD=dev-enrichment-pg-password
# Real provider credentials; empty stays in stub mode (embedded fixture
# catalog). Tilt flips the service to real once a full set is present.
# IGDB authenticates with a Twitch application, often the same app as
# the Twitch login provider above.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
PRICECHARTING_API_KEY=
# --- collection service ---
PG_COLLECTION_PASSWORD=dev-collection-pg-password
# --- social service ---
PG_SOCIAL_PASSWORD=dev-social-pg-password
# --- frontend site identity (build-time) ---
# Baked into the SPA at build; not secrets, not runtime env. Unset means
# name "vgkeep", upstream link, no operator/credits/providers shown.
# Tilt derives the two list values from the credentials above unless
# overridden here; what is set is what exists.
# Used verbatim - do not quote them; quotes would show up on the rendered page.
#VITE_SITE_NAME=
#VITE_SITE_OPERATOR=
#VITE_SITE_CONTACT=
#VITE_SITE_JURISDICTION=
#VITE_SITE_SOURCE_URL=
#VITE_SITE_DATA_SOURCES=igdb,pricecharting,frankfurter
#VITE_SITE_AUTH_PROVIDERS=google,twitch
# --- frontend build/telemetry (build-time) ---
# Build/release id stamped on telemetry (OTel service.version, plus a
# version attribute on the error counter and web-vitals). Not site
# identity; CI typically sets it to the git SHA or tag. Unset emits neither.
#VITE_BUILD_VERSION=
