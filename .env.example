# Copy to .env (gitignored). Tilt renders these into the ESO fake ClusterSecretStore.
# --- user service ---
PG_USER_PASSWORD=dev-user-pg-password
# --- auth service ---
PG_AUTH_PASSWORD=dev-auth-pg-password
# base64 of a 32-byte Ed25519 seed. This dev value decodes to readable
# ASCII on purpose (self-evidently not a production key). Generate real
# ones with: openssl rand -base64 32
AUTH_JWT_SIGNING_KEY=dmctY29sbGVjdC1kZXYtc2lnbmluZy1zZWVkLTAwMDE=
# Real "login with" apps; leave empty to keep that provider disabled
# (the dev provider covers credential-less local logins). When set,
# OAUTH_REDIRECT_URL below must be registered with the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Public callback for real providers; defaults to the local gateway.
# Only read when a real provider pair above is set.
OAUTH_REDIRECT_URL=http://localhost:8090/api/auth/callback
# --- bff ---
# base64 of a 32-byte AES key sealing the session cookie (same
# readable-ASCII convention as the signing seed above).
BFF_COOKIE_KEY=dmctY29sbGVjdC1kZXYtY29va2llLWtleS0wMDAwMDE=
# --- not yet used (uncomment when the owning service lands) ---
# PG_COLLECTION_PASSWORD=
# MONGO_ENRICHMENT_PASSWORD=
# IGDB_MODE=stub  PRICECHARTING_MODE=stub  PRICECHARTING_API_KEY=
